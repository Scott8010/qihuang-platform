{"clause_id": "HC-B-013", "kg_id": "4a25551c-2641-5816-8712-91e7eafc4172", "title": "涉癌宣称属严重违规，普通食品与调理服务一律禁止", "content": "全部删除涉癌表述，不得以任何形式暗示抗肿瘤功效", "source_ref": "《广告法》第十七/二十八条、《医疗广告管理办法》", "category": "B", "category_label": "疗效/功效承诺", "severity": "RED", "effective_action": "block", "keywords": ["抗癌", "防癌", "治癌", "抑制肿瘤", "杀死癌细胞"], "confidence": 0.95, "version": 1, "effective_date": "2026-01-01", "status": "active", "aligns_to": ["抗癌", "防癌", "治癌", "肿瘤"]}
