{"clause_id": "HC-A-001", "kg_id": "a96513cc-f5fc-5120-8948-a519d2425829", "title": "「第一」类绝对化用语，违反《广告法》第九条第(三)项（禁止使用国家级、最高级、最佳等用语）", "content": "删除排名表述，改为客观描述，如「专注XX领域的品牌」", "source_ref": "《广告法》第九条第(三)", "category": "A", "category_label": "夸大/绝对化用语", "severity": "RED", "effective_action": "block", "keywords": ["第一品牌"], "confidence": 0.98, "version": 1, "effective_date": "2026-01-01", "status": "active", "aligns_to": []}
{"clause_id": "HC-A-002", "kg_id": "b7ed8fca-6e93-5de2-9411-659bdf17dec5", "title": "「最」字类绝对化用语，违反《广告法》第九条第(三)项", "content": "删除「最」字表述，改为「较为适合」「广受认可」等相对描述", "source_ref": "《广告法》第九条第(三)", "category": "A", "category_label": "夸大/绝对化用语", "severity": "RED", "effective_action": "block", "keywords": ["最好的", "最佳", "最优", "最有效", "最强", "最权威", "最安全"], "confidence": 0.97, "version": 1, "effective_date": "2026-01-01", "status": "active", "aligns_to": []}
{"clause_id": "HC-A-003", "kg_id": "3adebd7f-ede1-580e-af2b-aebdec3d48f2", "title": "冒用国家级背书，违反《广告法》第九条第(二)项（不得使用国家机关名义）", "content": "删除国家级背书表述；确有资质请标注具体证书编号", "source_ref": "《广告法》第九条第(二)", "category": "A", "category_label": "夸大/绝对化用语", "severity": "RED", "effective_action": "block", "keywords": ["国家级", "国家指定", "国家认证", "央视推荐", "国宴专用"], "confidence": 0.96, "version": 1, "effective_date": "2026-01-01", "status": "active", "aligns_to": []}
{"clause_id": "HC-A-004", "kg_id": "6327ee82-e16d-5777-8fc4-af11df7d4887", "title": "准绝对化用语，缺乏可验证依据时构成误导", "content": "删除或补充可核验依据（如第三方检测报告、销售数据来源）", "source_ref": "《广告法》第九条第(三)项（绝对化用语）", "category": "A", "category_label": "夸大/绝对化用语", "severity": "ORANGE", "effective_action": "advise", "keywords": ["唯一", "独家", "首选", "顶级", "极致", "世界领先", "销量领先"], "confidence": 0.9, "version": 1, "effective_date": "2026-01-01", "status": "active", "aligns_to": []}
{"clause_id": "HC-A-005", "kg_id": "6ebb0f43-60bd-5db3-a543-c73a0d0c58ba", "title": "「无副作用」绝对化表述，中药材与调理手法存在个体差异，属误导性宣传", "content": "改为「本方剂性味平和，具体适用请咨询门店中医师」并补充禁忌提示", "source_ref": "《广告法》第九条第(三)项（绝对化用语）", "category": "A", "category_label": "夸大/绝对化用语", "severity": "ORANGE", "effective_action": "advise", "keywords": ["无任何副作用", "绝无副作用", "零副作用", "无任何风险", "绝对安全"], "confidence": 0.9, "version": 1, "effective_date": "2026-01-01", "status": "active", "aligns_to": []}
{"clause_id": "HC-A-006", "kg_id": "1d53ecb3-f8bf-581f-b199-2884377e839a", "title": "适用人群绝对化 / 对孕妇等禁忌人群作安全性宣称，忽视禁忌风险", "content": "明确适宜人群，并标注不适宜人群（孕妇、婴幼儿、慢病患者等）；禁忌人群一律改为「请遵医嘱」", "source_ref": "《广告法》第九条第(三)项（绝对化用语）", "category": "A", "category_label": "夸大/绝对化用语", "severity": "ORANGE", "effective_action": "advise", "keywords": ["适合所有人", "人人适用", "老少皆宜", "全民适用"], "confidence": 0.88, "version": 1, "effective_date": "2026-01-01", "status": "active", "aligns_to": []}
{"clause_id": "HC-A-007", "kg_id": "0b82230f-6fd4-50eb-b060-232849bf7e63", "title": "效果时效性绝对化承诺，属不可验证的夸大宣传", "content": "删除时效承诺，改为「坚持调理有助于逐步改善」", "source_ref": "《广告法》第九条第(三)项（绝对化用语）", "category": "A", "category_label": "夸大/绝对化用语", "severity": "ORANGE", "effective_action": "advise", "keywords": ["立竿见影", "当天见效", "终身受益", "永不复发"], "confidence": 0.86, "version": 1, "effective_date": "2026-01-01", "status": "active", "aligns_to": []}
{"clause_id": "HC-A-008", "kg_id": "1f2c2b0a-cc35-5091-bc53-9791bbb9f039", "title": "「祖传秘方」属含糊不实表述，来源与真实性无法验证", "content": "改为「传统中医配方」或标明具体方剂名（如参苓白术散加减）", "source_ref": "《广告法》第九条第(三)项（绝对化用语）", "category": "A", "category_label": "夸大/绝对化用语", "severity": "ORANGE", "effective_action": "advise", "keywords": ["祖传秘方", "宫廷秘方", "独门秘方", "祖传绝技"], "confidence": 0.85, "version": 1, "effective_date": "2026-01-01", "status": "active", "aligns_to": []}
{"clause_id": "HC-B-011", "kg_id": "f908b80d-51cc-5e27-9f6c-a2ac5f2775d0", "title": "疗效承诺用语，中医调理服务不得承诺治疗效果，违反《医疗广告管理办法》第七条", "content": "改为辅助调理类表述，如「辅助改善、日常调理」，不承诺结果", "source_ref": "《医疗广告管理办法》第七条", "category": "B", "category_label": "疗效/功效承诺", "severity": "RED", "effective_action": "block", "keywords": ["包治百病", "药到病除", "根治", "彻底治愈", "保证治愈", "治愈率"], "confidence": 0.98, "version": 1, "effective_date": "2026-01-01", "status": "active", "aligns_to": []}
