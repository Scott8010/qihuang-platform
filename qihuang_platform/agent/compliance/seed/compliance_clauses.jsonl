{"clause_id": "HC-B-017", "kg_id": "4690b107-5be2-52b5-829e-528e6d190c80", "title": "「排毒」类伪科学功效宣称，无医学定义支撑", "content": "改为「促进代谢/帮助消化」等有依据的表述", "source_ref": "《广告法》第十七/二十八条、《医疗广告管理办法》", "category": "B", "category_label": "疗效/功效承诺", "severity": "ORANGE", "effective_action": "advise", "keywords": ["排毒", "清宿便", "净化血液", "排出毒素"], "confidence": 0.85, "version": 1, "effective_date": "2026-01-01", "status": "active", "aligns_to": ["排毒", "清宿便", "净化血液"]}
{"clause_id": "HC-B-018", "kg_id": "28d27d99-2bad-5252-b70e-dbaae82ff2bf", "title": "效果描述主观且缺少客观评估依据", "content": "改为可量化描述（如「体质评估量表评分由7分降至4分」）", "source_ref": "《广告法》第十七/二十八条、《医疗广告管理办法》", "category": "B", "category_label": "疗效/功效承诺", "severity": "YELLOW", "effective_action": "advise", "keywords": ["改善明显", "效果显著", "效果特别好"], "confidence": 0.7, "version": 1, "effective_date": "2026-01-01", "status": "active", "aligns_to": []}
