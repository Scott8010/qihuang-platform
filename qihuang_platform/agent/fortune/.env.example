# ───────────────────────────────────────────────────────────
# fortune · LLM 象义层配置（OpenAI 兼容端点）
# 复制本文件为同目录 .env 后填入真实值；.env 已被 .gitignore 忽略，切勿提交真实密钥。
# 三项均未配置时：六爻接口仅返回规则装卦 + 用神定位/规则断语保底，不报错、不阻断。
# ───────────────────────────────────────────────────────────

# Chat 端点基址（代码会 rstrip('/') 后拼 /chat/completions）
# 官方示例：https://api.openai.com/v1 ；也可用自建/代理端点
FORTUNE_LLM_API_BASE=https://api.openai.com/v1

# API Key（仅服务端读取，走 Authorization: Bearer，绝不回显前端）
FORTUNE_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 模型名（按代理实际支持填写）
FORTUNE_LLM_MODEL=gpt-4o-mini
